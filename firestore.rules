rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userExists() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(roleList) { return isSignedIn() && (!userExists() || (getUserData().get('status', 'aktif') != 'nonaktif' && getUserData().get('role', 'keuangan') in roleList)); }
    function isActive() { return isSignedIn() && (!userExists() || getUserData().get('status', 'aktif') != 'nonaktif'); }
    function isAdminKeuangan() { return hasRole(['admin', 'keuangan']); }
    function isAdminKeuanganPSA() { return hasRole(['admin', 'keuangan', 'psa']); }
    function isApotekStaff() { return hasRole(['apotek', 'admin', 'keuangan', 'psa']); }
    function isKlinikStaff() { return hasRole(['klinik', 'dokter', 'admin', 'keuangan', 'psa']); }
    function isDokter() { return hasRole(['dokter', 'admin', 'keuangan', 'psa']); }
    function isAnyStaff() { return hasRole(['klinik', 'dokter', 'apotek', 'admin', 'keuangan', 'psa']); }
    function unchanged(field) { return request.resource.data[field] == resource.data[field]; }

    match /users/{uid} {
      allow get: if isSignedIn(); allow list: if isSignedIn(); allow create: if isSignedIn();
      allow update: if isAdminKeuangan() || (request.auth.uid == uid && unchanged('role') && unchanged('status'));
      allow delete: if isAdminKeuangan() && request.auth.uid != uid;
    }
    match /obat/{obatId} { allow read: if isSignedIn(); allow create, update: if isApotekStaff() && request.resource.data.stok is number && request.resource.data.stok >= 0; allow delete: if isAdminKeuanganPSA(); }
    match /transaksi/{trxId} { allow read: if isApotekStaff() || isKlinikStaff(); allow create: if isApotekStaff() || isDokter(); allow update, delete: if isAdminKeuanganPSA(); }
    match /pembelian/{id} { allow read, create: if isApotekStaff(); allow update, delete: if isAdminKeuanganPSA(); }
    match /retur/{id} { allow read, create: if isApotekStaff(); allow update: if isAdminKeuanganPSA() || (isApotekStaff() && resource.data.status == 'pending' && request.resource.data.status == 'pending'); allow delete: if isAdminKeuanganPSA(); }
    match /stockOpnameRequests/{id} { allow read, create: if isApotekStaff(); allow update, delete: if isAdminKeuanganPSA(); }
    match /stockOpnameHistory/{id} { allow read: if isApotekStaff(); allow create: if isAdminKeuanganPSA(); allow update, delete: if false; }
    match /pasien/{id} { allow read: if isKlinikStaff() || isApotekStaff(); allow create, update: if isKlinikStaff(); allow delete: if isAdminKeuanganPSA(); }
    match /rekamMedis/{id} { allow read: if isKlinikStaff() || isApotekStaff(); allow create, update: if isDokter() || isAdminKeuanganPSA(); allow update: if isApotekStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusResep']); allow delete: if isAdminKeuanganPSA(); }
    match /antrian/{id} { allow read: if isKlinikStaff() || isApotekStaff(); allow create, update: if isKlinikStaff(); allow delete: if isAdminKeuanganPSA(); }
    match /karyawan/{id} { allow read: if isAnyStaff(); allow create, update, delete: if hasRole(['keuangan', 'psa']); }

    // ABSENSI: scan hanya Admin/PSA/Keuangan; role lain hanya membaca miliknya sendiri.
    match /absensi/{id} {
      allow read: if isAdminKeuanganPSA() || (isActive() && resource.data.userId == request.auth.uid);
      allow create: if isAdminKeuanganPSA() && request.resource.data.metode == 'qr-admin' && request.resource.data.inputOlehUid == request.auth.uid && request.resource.data.checkOut == null && request.resource.data.karyawanId is string && request.resource.data.tanggal is string;
      allow create: if hasRole(['psa', 'keuangan']) && request.resource.data.metode == 'manual-koreksi' && request.resource.data.dikoreksiOlehUid == request.auth.uid && request.resource.data.checkOut == null && request.resource.data.karyawanId is string && request.resource.data.tanggal is string;
      allow update: if hasRole(['psa', 'keuangan']) && request.resource.data.metode == 'manual-koreksi' && request.resource.data.dikoreksiOlehUid == request.auth.uid && request.resource.data.checkOut == null && request.resource.data.karyawanId == resource.data.karyawanId && request.resource.data.userId == resource.data.userId && request.resource.data.tanggal == resource.data.tanggal;
      allow delete: if false;
    }

    // HAYPOP ETALASE: produk/harga hanya Keuangan. Produk aktif dapat dibaca
    // kasir apotek dan Keuangan. Penjualan dibuat atomik bersama transaksi.
    match /etalaseProduk/{id} {
      allow read: if hasRole(['apotek', 'keuangan']);
      allow create, update, delete: if hasRole(['keuangan']);
    }
    match /etalasePenjualan/{id} {
      allow read: if hasRole(['apotek', 'keuangan']);
      allow create: if hasRole(['apotek', 'keuangan'])
                    && request.resource.data.transaksiId is string
                    && request.resource.data.total is number
                    && request.resource.data.total > 0;
      allow update, delete: if hasRole(['keuangan']);
    }

    match /jurnalManual/{id} { allow read, write: if isAdminKeuangan(); }
    match /kasKeluar/{id} { allow read, create: if isApotekStaff(); allow update, delete: if isAdminKeuangan() || hasRole(['psa']); }
    match /saldoAwal/{id} { allow read, write: if isAdminKeuangan(); }
    match /pendapatanLain/{id} { allow read, create: if isApotekStaff(); allow update, delete: if hasRole(['keuangan']); }
    match /payrollHistory/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /payrollPeriode/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /piutangKaryawan/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /thrTabungan/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /thrPembayaranHistory/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /thrRekonsiliasi/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /thrPenyisihan/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /persediaanSnapshot/{id} { allow read, write: if isAdminKeuangan() || hasRole(['psa']); }
    match /kasMasuk/{id} { allow read, write: if isAdminKeuanganPSA(); }
    // Koleksi lama dipertahankan untuk kompatibilitas data historis.
    match /mutasiRekening/{id} { allow read, write: if isAdminKeuanganPSA(); }

    // MUTASI SALDO: akun Kas/Rekening dan ledger perpindahan dana internal.
    // Mutasi tidak boleh menjadi pendapatan/biaya; perubahan saldo dua akun
    // dilakukan oleh aplikasi dalam satu Firestore transaction.
    match /rekeningSaldo/{id} {
      allow read: if isAdminKeuanganPSA();
      allow create, update: if isAdminKeuanganPSA();
      allow delete: if isAdminKeuanganPSA() && id != 'kas';
    }
    match /mutasiSaldo/{id} {
      allow read: if isAdminKeuanganPSA();
      allow create: if isAdminKeuanganPSA()
                    && request.resource.data.tipe == 'transfer_internal'
                    && request.resource.data.dariId is string
                    && request.resource.data.keId is string
                    && request.resource.data.dariId != request.resource.data.keId
                    && request.resource.data.nominal is number
                    && request.resource.data.nominal > 0
                    && request.resource.data.tanggal is string;
      // Ledger mutasi sengaja immutable. Koreksi dilakukan dengan mutasi pembalik.
      allow update, delete: if false;
    }

    match /groupChat/{id} { allow read: if isActive(); allow create: if isActive() && request.resource.data.senderId == request.auth.uid; allow update, delete: if isActive() && (resource.data.senderId == request.auth.uid || isAdminKeuanganPSA()); }
    match /chatReadStatus/{uid} { allow read, write: if isActive() && request.auth.uid == uid; }
    match /auditLog/{id} { allow read: if isAdminKeuangan() || hasRole(['psa']); allow create: if isActive() && request.resource.data.olehUid == request.auth.uid; allow update, delete: if false; }
    match /pengaturan/antrianDisplay { allow read: if true; allow write: if isAnyStaff(); }
    match /pengaturan/antrianDisplaySettings { allow read: if true; allow write: if isAnyStaff(); }
    match /pengaturan/profil { allow read: if isAnyStaff(); allow write: if isAdminKeuanganPSA(); }
    match /pengaturan/satusehatSettings { allow read, write: if isAdminKeuanganPSA(); }
    match /pengaturan/psaInvestasi { allow read, write: if isAdminKeuanganPSA(); }
    match /pengaturan/landing { allow read: true; allow write: if hasRole(['keuangan', 'psa']); }
    match /pengaturanGaji/{id} { allow read, write: if isAdminKeuanganPSA(); }
    match /pengaturanPembagian/{id} { allow read: if isApotekStaff() || isKlinikStaff(); allow write: if isAdminKeuangan(); }
    match /pengaturanPembagianHistory/{id} { allow read: if isAdminKeuangan(); allow create: if isAdminKeuangan(); allow update, delete: if false; }
    match /masterTindakan/{id} { allow read: if isAnyStaff(); allow write: if isAdminKeuangan() || hasRole(['psa']); }
    match /{document=**} { allow read, write: if false; }
  }
}